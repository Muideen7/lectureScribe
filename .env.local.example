# Required
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
MONGODB_URI=your_mongodb_atlas_uri_here

# Required in production. Signs the per-visitor owner cookie that keeps each
# student's saved lectures private. Generate with: openssl rand -hex 32
# Keep it STABLE — changing it invalidates every cookie and orphans the
# lectures saved under the old value.
# IDENTITY_SECRET=replace_with_64_random_hex_chars

# Optional
MONGODB_DB=lecturescribe
OPENROUTER_MODEL=google/gemma-3-27b-it
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# Transcription model. whisper-large-v3 (default) is the most accurate;
# whisper-large-v3-turbo is ~2.8x cheaper and faster but less accurate.
# GROQ_MODEL=whisper-large-v3

# Optional rate-limit tuning (per client IP; see src/lib/rate-limit.ts)
# RATE_LIMIT_DISABLED=1
# TRANSCRIBE_PER_HOUR=6
# TRANSCRIBE_PER_DAY=30
# STRUCTURE_PER_HOUR=20
# STRUCTURE_PER_DAY=60
# SEARCH_PER_MINUTE=30
